{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^midterms2026\\.vitalos\\.space$"
        }
      ],
      "destination": "/midterms2026.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "midterms2026.vitalos.space"
        }
      ],
      "destination": "/midterms2026.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tsiaro-security.hatchable.site/api/:path*"
    },
    {
      "source": "/newsroom-admin.html",
      "destination": "https://tsiaro-security.hatchable.site/newsroom-admin.html"
    },
    {
      "source": "/loeil-mauricien.html",
      "destination": "https://tsiaro-security.hatchable.site/loeil-mauricien.html"
    },
    {
      "source": "/editorial-policy.html",
